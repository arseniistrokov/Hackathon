# Скопируй в .env. По умолчанию всё на L0: без сети, без моделей, без ключей.

# --- корпус ---
CORPUS=fixture            # fixture | real     fixture = data/fixture/mini_corpus в памяти; real = data/index/app.sqlite
DB_PATH=data/index/app.sqlite
EMB_PATH=data/index/embeddings.npy

# --- LLM (блок L1) ---
LLM=off                   # off | ollama | api     off = экстрактивный ответ без модели
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b   # ноут 5060 8 ГБ: gemma3n:e2b или qwen3:4b; ПК 3060 12 ГБ: gemma3:12b / qwen3:14b
API_BASE_URL=             # OpenAI-совместимый endpoint для fallback (api): https://api.openai.com/v1 или OpenRouter
API_KEY=
API_MODEL=
LLM_TIMEOUT_S=8

# --- retrieval (блоки R1, R2) ---
EMBEDDER=hash             # hash | bge-m3        hash = детерминированные char-ngram эмбеддинги без модели
RERANKER=lexical          # lexical | bge         bge = BAAI/bge-reranker-v2-m3 (extra ml)
RERANK_THRESHOLD=0.35     # ниже — NOT_FOUND. Калибруется по golden set, не «на глаз»
TOP_N=20                  # сколько кандидатов из гибридного поиска идёт в reranker
TOP_K=5                   # сколько passages идёт в модель
CITATION_RECOVERY_MAX=2   # верхний предел числа passages при детерминированном восстановлении citations

# --- скаут конфликтов (блок S1) ---
SCOUT=manual              # manual | llm          manual = data/fixture/conflicts.json / data/conflicts_manual.json

# --- STT (локальный faster-whisper) ---
STT=off                   # off | whisper         off = Web Speech API на клиенте; whisper = локальный faster-whisper
WHISPER_MODEL=medium      # base | small | medium | large-v3 (для GPU с >=8GB VRAM рекомендуется large-v3)
WHISPER_DEVICE=auto       # auto | cuda | cpu
WHISPER_COMPUTE=int8      # int8 | float16 | float32 | int8_float16

# --- сервер ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=200    # /api/ask, per-IP скользящее окно 60с
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # через запятую
